<body>

  <div id="root"></div>
  
  <!-- MediaPipe Hands for palm detection -->
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/hands/hands.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/camera_utils/camera_utils.js" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/@mediapipe/drawing_utils/drawing_utils.js" crossorigin="anonymous"></script>

  <!-- OpenCV.js for line detection -->
  <script>
    // OpenCV.js 로딩 완료 콜백
    window.onOpenCvReady = function() {
      console.log('✅ OpenCV.js loaded successfully');
      window.cvReady = true;
    };
  </script>
  <script async src="https://docs.opencv.org/4.8.0/opencv.js" onload="onOpenCvReady();" type="text/javascript"></script>
  
  <!-- Palm Reading AI Scripts -->
  <script src="palm-metadata.js"></script>
  <script src="palm-detector.js"></script>
  
  <!-- React Function Override: Inject Real AI -->
  <script>
    console.log('🔮 Injecting Real AI Palm Detection...');
    
    // Wait for React app to load and override the analysis function
    window.addEventListener('DOMContentLoaded', () => {
      // Poll for React root to be ready
      const checkReactReady = setInterval(() => {
        // Try to find and override the analysis function
        if (window.analyzePalmLines) {
          clearInterval(checkReactReady);
          
          console.log('✅ Found React analysis function, overriding with Real AI...');
          
          // Store original function as backup
          window.originalAnalyzePalmLines = window.analyzePalmLines;
          
          // Override with our real AI detection
          window.analyzePalmLines = async function(imageBuffer, culturalContext = 'eastern', language = 'ko') {
            console.log('🚀 Using REAL AI palm detection...');
            
            try {
              // Use our real detection from palm-detector.js
              // The global analyzePalm function is defined in palm-detector.js
              if (typeof analyzePalm === 'function') {
                const result = await new Promise((resolve) => {
                  // analyzePalm expects image element, so we need to convert buffer to image
                  const blob = new Blob([imageBuffer]);
                  const url = URL.createObjectURL(blob);
                  const img = new Image();
                  img.onload = () => {
                    URL.revokeObjectURL(url);
                    analyzePalm(img).then(resolve);
                  };
                  img.src = url;
                });
                
                console.log('✅ Real AI analysis complete:', result);
                return result;
              } else {
                console.warn('⚠️ analyzePalm not found, using fallback');
                return window.originalAnalyzePalmLines(imageBuffer, culturalContext, language);
              }
            } catch (error) {
              console.error('❌ Real AI error, using fallback:', error);
              return window.originalAnalyzePalmLines(imageBuffer, culturalContext, language);
            }
          };
          
          console.log('🎉 Real AI injection complete!');
        }
      }, 100);
      
      // Stop checking after 10 seconds
      setTimeout(() => {
        clearInterval(checkReactReady);
        console.log('⏰ React override timeout - app may need manual reload');
      }, 10000);
    });
  </script>
  
  <!-- This is a replit script which adds a banner on the top of the page when opened in development mode outside the replit environment -->
  <script type="text/javascript" src="https://replit.com/public/js/replit-dev-banner.js"></script>
</body>

